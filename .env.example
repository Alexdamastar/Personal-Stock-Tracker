# Postgres connection string (Neon or Supabase free tier)
DATABASE_URL=postgres://user:pass@host/db

# M2 quote providers. Order is the failover order; a provider named here with no
# key is a startup error, not a silent skip.
QUOTE_PROVIDERS=finnhub,twelvedata
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=

# Optional. Without a deadline one hung socket stalls the whole poll. Default 5000.
QUOTE_TIMEOUT_MS=5000
